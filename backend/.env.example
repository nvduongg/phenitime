# PostgreSQL (Prisma) — user/pass/db phải khớp POSTGRES_* trong .env gốc (Docker)
DATABASE_URL="postgresql://phenitime_user:phenitime_pass@localhost:5432/phenitime_db?schema=public"

# API
PORT=5000

# Redis (BullMQ scheduler queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Python scheduling engine
AI_CORE_URL=http://localhost:8000

# Solver job tuning (optional)
# SOLVER_HTTP_TIMEOUT_MS=0
# SOLVER_LOCK_DURATION_MS=3600000
# SOLVER_LOCK_RENEW_MS=15000

# JWT (bắt buộc đổi trên môi trường production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Tài khoản Ban Đào tạo (Đại học) — tự tạo lần đầu khi khởi động server
SEED_ADMIN_EMAIL=admin@phenikaa.edu.vn
SEED_ADMIN_PASSWORD=Phenitime@2026
SEED_ADMIN_NAME=Ban Đào tạo (Đại học)
