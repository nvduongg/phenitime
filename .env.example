# Docker Compose — copy to .env ở thư mục gốc
POSTGRES_USER=phenitime_user
POSTGRES_PASSWORD=phenitime_pass
POSTGRES_DB=phenitime_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# Cổng truy cập giao diện web (nginx → frontend + proxy /api → backend)
APP_PORT=8080

# Khi chạy docker compose, backend/core tự dùng host nội bộ (postgres-db, redis-db, core).
# Không cần backend/.env riêng trừ khi phát triển local không qua Docker.
