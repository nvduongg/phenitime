# Docker Compose — copy to .env ở thư mục gốc
POSTGRES_USER=phenitime_user
POSTGRES_PASSWORD=phenitime_pass
POSTGRES_DB=phenitime_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# Cổng truy cập giao diện web (nginx → frontend + proxy /api → backend)
APP_PORT=8080

# Đăng nhập (backend container đọc từ .env gốc khi dùng Docker)
JWT_SECRET=change-me-to-a-long-random-string
SEED_ADMIN_EMAIL=admin@phenikaa-uni.edu.vn
SEED_ADMIN_PASSWORD=Phenitime@2026

# Khi chạy docker compose, backend/core tự dùng host nội bộ (postgres-db, redis-db, core).
# Không cần backend/.env riêng; không cần chạy prisma migrate/seed thủ công trên máy host.
